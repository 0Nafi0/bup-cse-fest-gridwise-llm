# GridWise Environment Variables Template
# Copy this file to .env and fill in your credentials:
# cp .env.example .env

# Server Settings
ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM Provider Configuration
# Supported options: gemini, openai, groq, mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=15.0

# API Keys (set the key for your selected provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=

# Custom endpoint (required only if using custom proxy or Groq)
# LLM_BASE_URL=https://api.groq.com/openai/v1
